# ==================================================
# TrustShield - Environment Variables (.env.example)
# Detect. Verify. Protect.
# ==================================================

# GEMINI_API_KEY: Required for AI-assisted security analysis
# Injected automatically in Google AI Studio or configured via Secrets panel
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Base URL where this application is hosted
APP_URL="http://localhost:3000"

# SUPABASE_URL: URL of your Supabase Project (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# SUPABASE_ANON_KEY: Client/Edge Function publishable anonymous key
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Optional: Supabase service role key for backend administration (server-side only, never expose to client!)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# GOOGLE_SAFE_BROWSING_API_KEY: Official Google Safe Browsing API v4 key
# Obtain from Google Cloud Console: APIs & Services -> Credentials
GOOGLE_SAFE_BROWSING_API_KEY="YOUR_GOOGLE_SAFE_BROWSING_API_KEY"

# URLHAUS_AUTH_KEY: abuse.ch URLhaus API key (for malware URL database lookups)
# Obtain free from: https://urlhaus.abuse.ch/api/
URLHAUS_AUTH_KEY="YOUR_URLHAUS_AUTH_KEY"

# ALIENVAULT_OTX_API_KEY: AlienVault Open Threat Exchange (OTX) API key
# Obtain free from: https://otx.alienvault.com/api
ALIENVAULT_OTX_API_KEY="YOUR_ALIENVAULT_OTX_API_KEY"
